# Copy this file to .env and replace the placeholder keys. Never commit .env.
# The same keys can go in .streamlit/secrets.toml instead (top-level, same names).
#
# Providers: anthropic, openai, google_genai, groq, mistralai (mistralai needs `uv add langchain-mistralai`).
# The fallback is called once when the primary answers with a rate-limit (HTTP 429) error.
# A fallback on a different provider gives you an independent rate limit.

PRIMARY_LLM_PROVIDER=anthropic
PRIMARY_LLM_MODEL=claude-opus-5-5
PRIMARY_LLM_API_KEY=your-primary-api-key

FALLBACK_LLM_PROVIDER=anthropic
FALLBACK_LLM_MODEL=claude-sonnet-5-5
FALLBACK_LLM_API_KEY=your-fallback-api-key

# Optional
# LLM_TIMEOUT_SECONDS=120
# LOG_LEVEL=INFO
